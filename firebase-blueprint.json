{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Commercial CRM client leads and institutional sales opportunities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leadDate": { "type": "string" },
        "instituteName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "studentCount": { "type": "number" },
        "leadSource": { "type": "string" },
        "assignedTo": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "followUpDate": { "type": "string" },
        "remarks": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdDate": { "type": "string" },
        "updatedDate": { "type": "string" }
      },
      "required": ["id", "instituteName", "contactPerson", "mobile", "status"]
    },
    "FollowUp": {
      "title": "FollowUp",
      "description": "Follow-up schedules and client interaction history logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leadId": { "type": "string" },
        "followUpDate": { "type": "string" },
        "type": { "type": "string" },
        "discussion": { "type": "string" },
        "nextFollowUpDate": { "type": "string" },
        "status": { "type": "string" },
        "remarks": { "type": "string" },
        "createdDate": { "type": "string" },
        "assignedTo": { "type": "string" },
        "staff": { "type": "string" }
      },
      "required": ["id", "leadId", "status"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Institutional commercial proposals and generated quotes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "proposalNumber": { "type": "string" },
        "leadId": { "type": "string" },
        "instituteName": { "type": "string" },
        "templateId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "studentCount": { "type": "number" },
        "unitPrice": { "type": "number" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdDate": { "type": "string" },
        "createdBy": { "type": "string" },
        "validUntil": { "type": "string" }
      },
      "required": ["id", "proposalNumber", "leadId", "status"]
    },
    "User": {
      "title": "User",
      "description": "Authorized system user profiles and role allocations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "avatar": { "type": "string" },
        "staffId": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global enterprise settings and brand configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "brandName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "gstNumber": { "type": "string" }
      },
      "required": ["id", "companyName"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "HR Employee directory records and payroll allocations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "department": { "type": "string" },
        "designation": { "type": "string" },
        "employmentStatus": { "type": "string" }
      },
      "required": ["id", "fullName", "department"]
    },
    "DailyAttendanceRecord": {
      "title": "DailyAttendanceRecord",
      "description": "Daily employee punch-in and attendance logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "staffId", "date", "status"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "HR Leave applications, balances and approval workflows",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "staffId", "status"]
    },
    "ExpiryDocument": {
      "title": "ExpiryDocument",
      "description": "Enterprise compliance documents, permits and licenses with expiry tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "expiryDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "expiryDate"]
    },
    "AllocatedTask": {
      "title": "AllocatedTask",
      "description": "Work allocation tasks, checklists, and project deliverables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "assignedToName": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" }
      },
      "required": ["id", "title", "status"]
    },
    "AssetItem": {
      "title": "AssetItem",
      "description": "Fixed enterprise assets, physical inventory and IT hardware tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of all sales and institutional leads across all systems"
    },
    "/followups/{followUpId}": {
      "schema": "FollowUp",
      "description": "Collection of lead follow-up interactions across all systems"
    },
    "/proposals/{proposalId}": {
      "schema": "Proposal",
      "description": "Collection of commercial proposals across all systems"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user accounts across all systems"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global enterprise configuration and branding"
    },
    "/hr_staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Collection of HR staff and employee profiles across all systems"
    },
    "/hr_attendance/{attendanceId}": {
      "schema": "DailyAttendanceRecord",
      "description": "Collection of daily staff attendance records"
    },
    "/hr_leave_requests/{leaveId}": {
      "schema": "LeaveRequest",
      "description": "Collection of employee leave applications and approval workflows"
    },
    "/documents/{docId}": {
      "schema": "ExpiryDocument",
      "description": "Collection of corporate licenses, permits, and document renewals"
    },
    "/tasks/{taskId}": {
      "schema": "AllocatedTask",
      "description": "Collection of assigned department tasks and deliverables"
    },
    "/assets/{assetId}": {
      "schema": "AssetItem",
      "description": "Collection of enterprise equipment and asset registry items"
    }
  }
}
