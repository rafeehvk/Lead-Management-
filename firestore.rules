rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // CRM Modules
    match /leads/{leadId} {
      allow get, create, update, delete: if isValidId(leadId);
      allow list: if true;
    }
    match /followups/{followUpId} {
      allow get, create, update, delete: if isValidId(followUpId);
      allow list: if true;
    }
    match /proposals/{proposalId} {
      allow get, create, update, delete: if isValidId(proposalId);
      allow list: if true;
    }
    match /users/{userId} {
      allow get, create, update, delete: if isValidId(userId);
      allow list: if true;
    }
    match /settings/{settingId} {
      allow get, create, update, delete: if isValidId(settingId);
      allow list: if true;
    }

    // HR Management Modules
    match /hr_staff/{staffId} {
      allow get, create, update, delete: if isValidId(staffId);
      allow list: if true;
    }
    match /hr_attendance/{attendanceId} {
      allow get, create, update, delete: if isValidId(attendanceId);
      allow list: if true;
    }
    match /hr_leave_requests/{leaveId} {
      allow get, create, update, delete: if isValidId(leaveId);
      allow list: if true;
    }
    match /hr_departments/{deptId} {
      allow get, create, update, delete: if isValidId(deptId);
      allow list: if true;
    }
    match /hr_branches/{branchId} {
      allow get, create, update, delete: if isValidId(branchId);
      allow list: if true;
    }
    match /hr_positions/{positionId} {
      allow get, create, update, delete: if isValidId(positionId);
      allow list: if true;
    }
    match /hr_applicants/{applicantId} {
      allow get, create, update, delete: if isValidId(applicantId);
      allow list: if true;
    }
    match /hr_department_roles/{roleId} {
      allow get, create, update, delete: if isValidId(roleId);
      allow list: if true;
    }
    match /user_menu_permissions/{permId} {
      allow get, create, update, delete: if isValidId(permId);
      allow list: if true;
    }

    // ERP Core Modules (Parties, Items, Orders, Invoices, Finance)
    match /erp_parties/{partyId} {
      allow get, create, update, delete: if isValidId(partyId);
      allow list: if true;
    }
    match /erp_items/{itemId} {
      allow get, create, update, delete: if isValidId(itemId);
      allow list: if true;
    }
    match /erp_sales_orders/{orderId} {
      allow get, create, update, delete: if isValidId(orderId);
      allow list: if true;
    }
    match /erp_sales_invoices/{invoiceId} {
      allow get, create, update, delete: if isValidId(invoiceId);
      allow list: if true;
    }
    match /erp_purchase_orders/{poId} {
      allow get, create, update, delete: if isValidId(poId);
      allow list: if true;
    }
    match /erp_purchase_invoices/{piId} {
      allow get, create, update, delete: if isValidId(piId);
      allow list: if true;
    }
    match /erp_stock_movements/{stockId} {
      allow get, create, update, delete: if isValidId(stockId);
      allow list: if true;
    }
    match /finance_journals/{journalId} {
      allow get, create, update, delete: if isValidId(journalId);
      allow list: if true;
    }

    // Document Expiry & Compliance Registry
    match /documents/{docId} {
      allow get, create, update, delete: if isValidId(docId);
      allow list: if true;
    }

    // Task Allocation
    match /tasks/{taskId} {
      allow get, create, update, delete: if isValidId(taskId);
      allow list: if true;
    }

    // Asset Management
    match /assets/{assetId} {
      allow get, create, update, delete: if isValidId(assetId);
      allow list: if true;
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
