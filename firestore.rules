rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // CRM Modules
    match /leads/{leadId} {
      allow read, write: if isValidId(leadId);
    }
    match /followups/{followUpId} {
      allow read, write: if isValidId(followUpId);
    }
    match /proposals/{proposalId} {
      allow read, write: if isValidId(proposalId);
    }
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // HR Management Modules
    match /hr_staff/{staffId} {
      allow read, write: if isValidId(staffId);
    }
    match /hr_attendance/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }
    match /hr_leave_requests/{leaveId} {
      allow read, write: if isValidId(leaveId);
    }
    match /hr_positions/{positionId} {
      allow read, write: if isValidId(positionId);
    }
    match /hr_applicants/{applicantId} {
      allow read, write: if isValidId(applicantId);
    }

    // Document Expiry & Compliance Registry
    match /documents/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Task Allocation
    match /tasks/{taskId} {
      allow read, write: if isValidId(taskId);
    }

    // Asset Management
    match /assets/{assetId} {
      allow read, write: if isValidId(assetId);
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
